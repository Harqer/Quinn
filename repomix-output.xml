      if (res.ok) {
        const data = await res.json();
        this.spotifyConnected = data.connected;
        this.spotifySource = data.source || "";
        this.spotifyAccessToken = data.token || "";
        if (this.spotifyConnected) {
          void this.fetchSpotifyData();
        } else {
          this.spotifyAccessToken = "";
