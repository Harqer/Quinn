  @fdc_forbiddenAsFieldType
  @fdc_example(value: ["user123", "active"], description: "List of values for $1, $2, etc.")
  @fdc_example(value: [{_expr: "auth.uid"}, "active"], description: "List of values using an expression for the first parameter.")
  @fdc_example(value: [{_expr: "response.step1.id"}, "active"], description: "Reference results from previous steps.")

