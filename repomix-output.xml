    if (this.feedType === "webcam" && (!this.videoElement || !this.cameraStream)) return;

    const snapshot = this.getStreamSnapshot();
    if (!snapshot) return;

    const base64Data = snapshot.split(",")[1];
    await this.lyriaApiService.generateFromFrame(this, base64Data);
  }


