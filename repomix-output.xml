package com.musically.studio.ui

import android.app.Activity
import android.content.Context
import android.content.Intent
import androidx.lifecycle.viewModelScope
import com.musically.studio.network.*
import com.musically.studio.data.repository.*
import kotlinx.coroutines.launch
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import org.json.JSONObject
import timber.log.Timber
import java.util.*
import android.util.Base64
import com.musically.studio.audio.StreamAudioPlayer
import com.musically.studio.WearableStreamingService
import com.musically.studio.billing.GenerationBlockReason
import com.musically.studio.ui.models.ChatMessage

    fun MainViewModel.startLiveSession() {
        if (!_hasAcceptedPrivacyPolicy.value) return
        if (_isLiveSessionActive.value) return
        _isLiveSessionActive.value = true
        
        // Fetch ephemeral token directly via Firebase Functions
        viewModelScope.launch {
            try {
                val functions = com.google.firebase.functions.FirebaseFunctions.getInstance()
                functions.getHttpsCallable("getLiveToken").call()
                    .addOnSuccessListener { result ->
                        val data = result.data as? Map<*, *>
                        val token = data?.get("token") as? String
                        if (!token.isNullOrBlank()) {
                            geminiLiveManager.connect(token)
                        } else {
                            Timber.e("Failed to get token from Firebase Functions")
                            _isLiveSessionActive.value = false
                        }
                    }
                    .addOnFailureListener { e ->
                        Timber.e(e, "Error calling getLiveToken function")
                        _isLiveSessionActive.value = false
                    }
            } catch (e: Exception) {
                Timber.e(e, "Failed to invoke getLiveToken")
                _isLiveSessionActive.value = false
            }
        }
        
        // Optional: start RTDB sync for state
        startRtdbSync()
    }

    fun MainViewModel.clearLiveSessionHistory() {
        messages.clear()
        stopLiveSession()
        startLiveSession()
    }

    fun MainViewModel.stopLiveSession() {
        if (_isRecording.value) {
            stopRecording()
        }
        _isLiveSessionActive.value = false
        geminiLiveManager.disconnect()
    }

    fun MainViewModel.connectToMave() {
        startLiveSession()
    }

    fun MainViewModel.generateCoverMedia(trackId: String?, prompt: String, type: String, onResult: (String?) -> Unit) {
        viewModelScope.launch {
            val result = apiClient.generateCoverMedia(prompt, type)
            if (result != null && trackId != null) {
                _tracks.value = _tracks.value.map { track ->
                    if (track.id == trackId) {
                        track.copy(album = track.album.copy(images = listOf(com.musically.studio.network.MaveImage(result, 640, 640))))
                    } else track
                }
            }
            onResult(result)
        }
    }

    fun MainViewModel.sendTextCommand(text: String) {
        messages.add(0, ChatMessage(text, true))
        _thinkingText.value = ""
        if (_isLiveSessionActive.value) {
            geminiLiveManager.sendText("Feedback: $text")
        }
    }

    fun MainViewModel.generatePodcast(text: String) {
        // --- Quota guardrail ---
        val limits = tierLimits
        if (!limits.podcastsUnlimited && _podcastEpsThisMonth.value >= limits.podcastEpsPerMonth) {
            viewModelScope.launch { _generationBlockedEvent.emit(GenerationBlockReason.PODCASTS_LIMIT_REACHED) }
            return
        }
        messages.add(0, ChatMessage(text, true))
        _thinkingText.value = ""
        currentAudioPlayer?.stop()
        currentAudioPlayer = com.musically.studio.audio.StreamAudioPlayer()
        
        viewModelScope.launch {
            try {
                streamingApiClient.generatePodcastStream(text).collect { event ->
                    if (event.text != null) {
                        _thinkingText.value += event.text
                    }
                    if (event.audioBase64 != null) {
                        currentAudioPlayer?.queueAudioChunk(event.audioBase64)
                    }
                    if (event.isComplete) {
                        _thinkingText.value = ""
                        val script = event.trackInfo?.audioUrl ?: "Generated Podcast"
                        messages.add(0, ChatMessage(script, false, event.trackInfo?.id))
                        event.trackInfo?.let { track ->
                            _currentPlayingTrack.value = track
                            _isPlaying.value = true
                        }
                        currentAudioPlayer?.stop()
                        currentAudioPlayer = null
                    }
                }
            } catch (e: Exception) {
                Timber.e(e, "Error generating podcast")
                messages.add(0, ChatMessage("Error generating podcast", false))
                _thinkingText.value = ""
                currentAudioPlayer?.stop()
                currentAudioPlayer = null
            }
        }
    }

    fun MainViewModel.recordVoice(context: Context?) {
        if (!_hasAcceptedPrivacyPolicy.value) return
        if (_isRecording.value) {
            stopRecording()
        } else {
            startRecording(context)
        }
    }

    internal fun MainViewModel.startRecording(context: Context?) {
        context?.let {
            val intent = Intent(it, WearableStreamingService::class.java)
            it.startForegroundService(intent)
        }
        _isRecording.value = true
        WearableStreamingService.startVoiceRecording()
    }

    internal fun MainViewModel.stopRecording() {
        _isRecording.value = false
        WearableStreamingService.stopVoiceRecording()
    }

    fun MainViewModel.sendFrame(base64: String) {
        if (_isLiveSessionActive.value) {
            val bytes = Base64.decode(base64, Base64.NO_WRAP)
            geminiLiveManager.sendVideoFrame(bytes)
        }
    }

    fun MainViewModel.generateMusicPrompts(base64: String) {
        // --- Quota guardrail (client-side UX; server-side enforcement is a separate requirement) ---
        val limits = tierLimits
        if (!limits.songsUnlimited && _songsThisMonth.value >= limits.songsPerMonth) {
            viewModelScope.launch { _generationBlockedEvent.emit(GenerationBlockReason.SONGS_LIMIT_REACHED) }
            return
        }
        viewModelScope.launch {
            _isLoading.value = true
            _pendingGalleryImageBase64.value = base64
            // Also send as a vision frame to the live session if active
            if (_isLiveSessionActive.value) {
                maveSessionManager.sendVideoFrame(
                    Base64.decode(base64, Base64.NO_WRAP)
                )
            }
            val result = apiClient.generateMusicPrompts(base64)
            if (result != null) {
                _generatedPrompts.value = result
                // Increment the song counter on successful generation
                incrementUsageCounter("songs_generated")
                // Auto-send generated prompts to session if active
                if (_isLiveSessionActive.value && result.isNotEmpty()) {
                    val promptText = result.joinToString("; ")
                    geminiLiveManager.sendText("Please consider these generated prompts: $promptText")
                }
            }
            _isLoading.value = false
        }
    }
    fun MainViewModel.generateFromTrack(track: MaveTrack) {
        val limits = tierLimits
        if (!limits.songsUnlimited && _songsThisMonth.value >= limits.songsPerMonth) {
            viewModelScope.launch { _generationBlockedEvent.emit(GenerationBlockReason.SONGS_LIMIT_REACHED) }
            return
        }
        viewModelScope.launch {
            _isLoading.value = true
            
            val result = apiClient.generateMusicPromptsFromSpotify(track)
            if (result != null) {
                _generatedPrompts.value = result
                incrementUsageCounter("songs_generated")
                if (_isLiveSessionActive.value && result.isNotEmpty()) {
                    val promptText = result.joinToString("; ")
                    geminiLiveManager.sendText("Please consider these generated prompts from Spotify track: $promptText")
                }
            }
            _isLoading.value = false
        }
    }


    fun MainViewModel.onGalleryImageSelected(base64: String) {
        generateMusicPrompts(base64)
    }

    fun MainViewModel.clearPendingGalleryImage() {
        _pendingGalleryImageBase64.value = null
    }

    fun MainViewModel.applySteering(params: Map<String, Any>) {
        if (_isLiveSessionActive.value) {
            geminiLiveManager.sendText("User applied steering parameters: $params")
        }
    }
