            audio_bytes = io.BytesIO()
            wav.write(audio_bytes)
            audio_bytes.seek(0)
            
            b64_chunk = base64.b64encode(audio_bytes.read()).decode('utf-8')
            await websocket.send_json({"chunk": b64_chunk})
