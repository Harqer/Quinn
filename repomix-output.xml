                    containerColor = Color.Transparent
                )
            )
        }
    ) { paddingValues ->
        Box(modifier = Modifier.fillMaxSize()) {
            // Gradient Header for Playlist (using a generic green/dark gradient)
            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .height(400.dp)
