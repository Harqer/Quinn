    id: string;
    title: string;
    album: {
      id: string;
      title: string;
      primaryArtist: {
        id: string;
        name: string;
      } & Artist_Key;
    } & Album_Key;
    coverUrl?: string | null;
    audioUrl: string;
    prompt?: string | null;
    visibility: string;
    isCommunity: boolean;
    createdAt: TimestampString;
  } & Track_Key)[];
}
```
