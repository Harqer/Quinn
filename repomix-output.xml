  track_insert(data: {
    title: $title,
    albumId: $albumId,
    audioUrl: $audioUrl,
    coverUrl: $coverUrl,
    isCommunity: $isCommunity,
    durationMs: 0,
    ownerUid_expr: "auth.uid"
  })
}

