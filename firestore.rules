rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Ensure protected administrative fields cannot be altered or set by clients
    function isNotModifyingAdminFields() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return !affectedKeys.hasAny(['subscriptionTier', 'stripeCustomerId', 'isAdmin', 'role', 'generations']);
    }

    function isNotSettingAdminFields() {
      return !request.resource.data.keys().hasAny(['subscriptionTier', 'stripeCustomerId', 'isAdmin', 'role', 'generations']);
    }

    function isValidUserDoc() {
      return request.resource.data.get('displayName', '') is string
          && request.resource.data.get('email', '') is string;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid 
                    && isNotSettingAdminFields()
                    && isValidUserDoc();
      allow update: if request.auth != null && request.auth.uid == uid 
                    && isNotModifyingAdminFields();
      allow delete: if false;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    
    match /user_quotas/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Quotas managed strictly via Admin SDK in Cloud Functions
    }
    
    match /customers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid 
                    && isNotSettingAdminFields();
      allow update: if request.auth != null && request.auth.uid == uid 
                    && isNotModifyingAdminFields();
      allow delete: if false;
                   
      match /checkout_sessions/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null && request.auth.uid == uid;
        allow delete: if false;
      }
      match /subscriptions/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false; // Managed by Stripe Webhook via Admin SDK
      }
      match /payments/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false; // Managed by Stripe Webhook via Admin SDK
      }
    }

    // Globally deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
