{
  "hosting": {
    "public": "dist",
    "i18n": {
      "root": "/"
    },
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "musically-studio",
          "region": "us-central1"
        }
      },
      {
        "source": "/vibe/**",
        "run": {
          "serviceId": "musically-studio",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "dataconnect": {
    "source": "dataconnect"
  },
  "database": {
    "rules": "database.rules.json"
  }
}
