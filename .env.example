# Gemini API Configuration (Managed Server-Side)
GEMINI_API_KEY=

# Sentry Crash Tracking and Performance Monitoring
SENTRY_DSN=

# Spotify Integration API Keys & Credentials
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional Fallback: Paste a pre-created Spotify Developer access token directly here
# to bypass OAuth and immediately enable Web API requests in testing and previews
SPOTIFY_BEARER_TOKEN=
